# Variables del servicio Node.js de Railway. No copiar el .env local completo.
NODE_ENV=production
CORS_ORIGINS=https://front-hotel-manager-mu.vercel.app
SQLSERVER_HOST=REEMPLAZAR_HOST_ACCESIBLE_DESDE_RAILWAY
SQLSERVER_DATABASE=HotelManagerDB
SQLSERVER_USER=REEMPLAZAR_USUARIO
SQLSERVER_PASSWORD=REEMPLAZAR_CLAVE
# Conector actual: el valor 'false' activa el cifrado TLS.
SQLSERVER_ENCRYPT=false
# Usar true solo si el SQL Server elegido requiere confiar en su certificado.
SQLSERVER_TRUST_CERT=false
SESSION_COOKIE_NAME=hotelmanager_session
SESSION_HOURS=12
SESSION_REMEMBER_HOURS=720
SECURITY_ADMIN_ROLES=ADMINFULL
# Railway proporciona PORT. No configurar SQLSERVER_HOST=localhost.
